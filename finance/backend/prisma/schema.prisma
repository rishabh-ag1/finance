// Entelechy Finance - Prisma schema.
// Same conventions as Bloc's crm/backend/prisma/schema.prisma: multiSchema, cuid string ids,
// PascalCase models with camelCase columns, schema changes via `prisma db push` (no migrations dir).
// Every model lives in the Postgres schema "finance". Finance never writes to the CRM's schemas.
// What Prisma cannot express (audit triggers, no-hard-delete triggers, check constraints) is in
// prisma/sql/finance.sql, applied by `npm run db:sync` right after the push.
// Every model must have a single `id` column: the audit trigger keys AuditLog rows on it.

generator client {
  provider        = "prisma-client-js"
  engineType      = "binary"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["finance"]
}

// ---------- Users, roles & audit (M16) ----------
// Same shape as Bloc's User / Role so the founders can move to the CRM's single login when the
// apps are merged. Permissions use finance-prefixed module keys (financeBank, financeVendors...).

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String?
  firstName           String
  lastName            String
  roleId              String?
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(6)
  lastLoginAt         DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  role                Role?     @relation(fields: [roleId], references: [id])

  @@schema("finance")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// e.g. {"financeBank":{"view":true,"edit":true},"financeAudit":{"view":true}}
  permissions Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  users       User[]

  @@schema("finance")
}

enum AuditAction {
  create
  update
  archive
  cancel
  unlock
  delete_refused
  other

  @@schema("finance")
}

/// BR-43. Written by the database trigger finance.audit_row() on every insert/update of every
/// finance table, inside the same transaction, so no change can skip it. Append only.
model AuditLog {
  id         BigInt      @id @default(autoincrement())
  recordType String
  recordId   String
  action     AuditAction
  field      String?
  oldValue   Json?
  newValue   Json?
  reason     String?
  /// User.id of the person, or "system" for seed/import jobs.
  userId     String
  at         DateTime    @default(now()) @db.Timestamptz(6)

  @@index([recordType, recordId])
  @@index([userId])
  @@index([at])
  @@schema("finance")
}

// ---------- Settings & masters (M01) ----------
// createdBy / updatedBy are stamped by the database (finance.stamp_actor) from withAudit's user.

/// F001, F002. One row in v1 (Entelechy Labs); business records point at it with entityId (D5).
model Company {
  id                String    @id @default(cuid())
  legalName         String
  brandName         String?
  cin               String?
  pan               String
  tan               String?
  gstin             String
  udyamNo           String?
  registeredAddress String
  stateCode         String    @db.Char(2)
  /// Fixed at 4 (April, BR-31).
  fyStartMonth      Int       @default(4) @db.SmallInt
  /// 22 May 2026. Months of the first FY before this show as zero (Q12).
  incorporationDate DateTime? @db.Date
  /// BR-10: advances without a tax invoice older than this many days go on the chase list.
  taxInvoiceChaseDays Int     @default(15) @db.SmallInt
  email             String?
  phone             String?
  logoFileId        String?
  signatureFileId   String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  createdBy         String?
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)
  updatedBy         String?

  bankAccounts BankAccount[]
  numberSeries NumberSeries[]
  importBatches BankImportBatch[]
  bankTxns     BankTxn[]

  @@schema("finance")
}

enum AccountType {
  business_current
  cash_credit
  founder_personal
  loan
  wallet
  card

  @@schema("finance")
}

/// F003. A cash credit account's balance is money drawn, a liability (BR-50).
model BankAccount {
  id               String      @id @default(cuid())
  entityId         String
  bankName         String
  accountName      String
  accountNumber    String
  ifsc             String
  branch           String?
  accountType      AccountType
  /// Entelechy, or the founder's name for founder_personal accounts.
  owner            String
  openingBalance   Decimal     @default(0) @db.Decimal(14, 2)
  openingDate      DateTime    @db.Date
  /// Statement parser, e.g. idfc_v1 (F010), pnb_cc_v1 (F024).
  parserFormat     String?
  sanctionedLimit  Decimal?    @db.Decimal(14, 2)
  drawingPower     Decimal?    @db.Decimal(14, 2)
  drawingPowerAsOf DateTime?   @db.Date
  interestRate     Decimal?    @db.Decimal(6, 3)
  renewalDate      DateTime?   @db.Date
  isActive         Boolean     @default(true)
  isArchived       Boolean     @default(false)
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  createdBy        String?
  updatedAt        DateTime    @updatedAt @db.Timestamptz(6)
  updatedBy        String?
  entity           Company     @relation(fields: [entityId], references: [id])
  importBatches    BankImportBatch[]
  txns             BankTxn[]

  @@unique([bankName, accountNumber])
  @@schema("finance")
}

// ---------- Bank & cash ledger (M02) ----------

enum BalanceCheckStatus {
  ok
  gap
  mismatch

  @@schema("finance")
}

/// F010-F012. One row per uploaded statement file.
model BankImportBatch {
  id                 String             @id @default(cuid())
  entityId           String
  bankAccountId      String
  fileName           String
  /// sha256 of the file, so the same download is recognised.
  fileHash           String
  /// Google Drive id of the stored file (M15, documents vault).
  fileDriveId        String?
  periodFrom         DateTime           @db.Date
  periodTo           DateTime           @db.Date
  rowsTotal          Int
  rowsNew            Int
  rowsDuplicate      Int
  openingBalance     Decimal            @db.Decimal(14, 2)
  closingBalance     Decimal            @db.Decimal(14, 2)
  balanceCheckStatus BalanceCheckStatus
  /// BR-03 notes in plain English, one per line.
  balanceCheckNote   String?
  missingFrom        DateTime?          @db.Date
  missingTo          DateTime?          @db.Date
  totalDebit         Decimal            @db.Decimal(14, 2)
  totalCredit        Decimal            @db.Decimal(14, 2)
  importedBy         String
  importedAt         DateTime           @default(now()) @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  createdBy          String?
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  updatedBy          String?
  entity             Company            @relation(fields: [entityId], references: [id])
  bankAccount        BankAccount        @relation(fields: [bankAccountId], references: [id])
  txns               BankTxn[]

  @@index([bankAccountId, importedAt])
  @@schema("finance")
}

enum BankTxnStatus {
  review
  suggested
  categorised
  matched
  split
  transfer
  ignored

  @@schema("finance")
}

enum PartyType {
  vendor
  customer
  founder
  lender
  govt
  own_account
  other

  @@schema("finance")
}

/// F013-F021. One bank statement row. The imported facts (date, narration, amounts, balance)
/// never change (database trigger); everything a person decides sits in separate columns.
model BankTxn {
  id                   String        @id @default(cuid())
  entityId             String
  bankAccountId        String
  /// Null for manual cash entries (F022).
  batchId              String?
  /// Position in the account's statement (oldest first); orders rows within a day.
  seq                  Int
  txnDate              DateTime      @db.Date
  valueDate            DateTime?     @db.Date
  narrationRaw         String
  chequeNo             String?
  debit                Decimal       @default(0) @db.Decimal(14, 2)
  credit               Decimal       @default(0) @db.Decimal(14, 2)
  balance              Decimal?      @db.Decimal(14, 2)
  /// BR-01: account | date | narration | debit | credit | balance.
  dedupeKey            String
  // Parsed from the narration (BR-02). parseOk = false sends the row to Review.
  parseOk              Boolean       @default(false)
  mode                 String?
  modeDetail           String?
  utr                  String?
  counterpartyName     String?
  counterpartyIfsc     String?
  counterpartyAccount  String?
  counterpartyBank     String?
  ref2                 String?
  remark               String?
  // Decided by people or rules (M3).
  description          String?
  categoryId           String?
  subCategoryId        String?
  nature               TxnNature?
  partyType            PartyType?
  partyId              String?
  status               BankTxnStatus @default(review)
  categorisationReason String?
  transferPairId       String?
  linkedDocType        String?
  linkedDocId          String?
  isManual             Boolean       @default(false)
  /// BR-29 sub-type for Related Party rows: business_transfer, director_loan, capital, undecided.
  relatedPartyType     String?
  notes                String?
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  createdBy            String?
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)
  updatedBy            String?
  entity               Company       @relation(fields: [entityId], references: [id])
  bankAccount          BankAccount   @relation(fields: [bankAccountId], references: [id])
  batch                BankImportBatch? @relation(fields: [batchId], references: [id])
  splits               TxnSplit[]

  @@unique([bankAccountId, dedupeKey])
  @@index([bankAccountId, txnDate, seq])
  @@index([status])
  @@index([counterpartyName])
  @@schema("finance")
}

/// BR-07, F018. Lines of a split bank row; they add up to the bank amount to the paisa.
/// Unsplitting archives the lines (never deleted).
model TxnSplit {
  id            String     @id @default(cuid())
  bankTxnId     String
  lineNo        Int
  amount        Decimal    @db.Decimal(14, 2)
  categoryId    String
  subCategoryId String?
  nature        TxnNature
  partyType     PartyType?
  description   String?
  linkedDocType String?
  linkedDocId   String?
  note          String?
  isArchived    Boolean    @default(false)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  createdBy     String?
  updatedAt     DateTime   @updatedAt @db.Timestamptz(6)
  updatedBy     String?
  bankTxn       BankTxn    @relation(fields: [bankTxnId], references: [id])

  @@index([bankTxnId])
  @@schema("finance")
}

// ---------- Vendors (M03) ----------

enum VendorType {
  goods
  services
  both

  @@schema("finance")
}

enum DeducteeType {
  individual
  huf
  company
  firm
  others
  unknown

  @@schema("finance")
}

enum MsmeType {
  micro
  small
  medium
  none

  @@schema("finance")
}

enum VendorStatus {
  draft
  pending_review
  active
  blocked

  @@schema("finance")
}

/// F030-F038. PAN, state and deductee type always come from the GSTIN / PAN (BR-12, BR-15).
model Vendor {
  id                   String       @id @default(cuid())
  entityId             String
  displayName          String
  legalName            String?
  tradeName            String?
  vendorType           VendorType
  gstRegistered        Boolean      @default(false)
  gstin                String?
  pan                  String?
  deducteeType         DeducteeType @default(unknown)
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  stateCode            String?      @db.Char(2)
  pincode              String?      @db.Char(6)
  contactName          String?
  phone                String?
  email                String?
  defaultTdsSectionId  String?
  ldcNumber            String?
  ldcRate              Decimal?     @db.Decimal(5, 2)
  ldcValidFrom         DateTime?    @db.Date
  ldcValidTo           DateTime?    @db.Date
  ldcLimit             Decimal?     @db.Decimal(14, 2)
  msmeType             MsmeType     @default(none)
  udyamNo              String?
  defaultCategoryId    String?
  defaultSubCategoryId String?
  paymentTermId        String?
  status               VendorStatus @default(draft)
  statusReason         String?
  /// Names this vendor appears under in bank narrations (BR-05 step 2), e.g. "SAIFFI INDUSTRIES".
  bankNames            String[]     @default([])
  notes                String?
  isArchived           Boolean      @default(false)
  createdAt            DateTime     @default(now()) @db.Timestamptz(6)
  createdBy            String?
  updatedAt            DateTime     @updatedAt @db.Timestamptz(6)
  updatedBy            String?
  bankAccounts         VendorBankAccount[]
  purchaseOrders       PurchaseOrder[]
  documents            VendorDocument[]

  @@index([displayName])
  @@index([pan])
  @@schema("finance")
}

enum VendorBankStatus {
  pending
  approved
  rejected
  superseded

  @@schema("finance")
}

/// F035, BR-16. Every change is a new row: on an active vendor it waits for another founder's
/// approval; the old details stay as history (superseded).
model VendorBankAccount {
  id             String           @id @default(cuid())
  vendorId       String
  accountName    String
  accountNumber  String
  ifsc           String
  bankName       String?
  branch         String?
  status         VendorBankStatus @default(pending)
  requestedBy    String
  requestedAt    DateTime         @default(now()) @db.Timestamptz(6)
  decidedBy      String?
  decidedAt      DateTime?        @db.Timestamptz(6)
  decisionNote   String?
  validFrom      DateTime?        @db.Timestamptz(6)
  validTo        DateTime?        @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  createdBy      String?
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  updatedBy      String?
  vendor         Vendor           @relation(fields: [vendorId], references: [id])

  @@index([vendorId, status])
  @@schema("finance")
}

// ---------- Documents vault (M15) ----------

/// F160. A file attached to any record. The file lives in storage (Google Drive, or the local
/// folder until Drive is set up); this row is the index. Removing an attachment archives it
/// with a reason; the file is kept.
model Attachment {
  id             String   @id @default(cuid())
  /// Table of the record it belongs to: Vendor, BankTxn, BankImportBatch...
  recordType     String
  recordId       String
  /// gst_cert, pan, cancelled_cheque, msme_cert, agreement, statement, proof, bill, other
  docKind        String
  fileName       String
  originalName   String
  mimeType       String
  sizeBytes      Int
  sha256         String
  /// local or drive
  storage        String
  /// Drive file id, or the path under the local storage folder.
  storageKey     String
  /// /Finance/{FY}/{Module}/{Record}
  folderPath     String
  note           String?
  uploadedBy     String
  isArchived     Boolean  @default(false)
  archivedReason String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  createdBy      String?
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  updatedBy      String?

  @@index([recordType, recordId])
  @@index([sha256])
  @@schema("finance")
}

/// Cache of gstinapi.in lookups (I11), so the 100 free lookups a month are not spent twice.
model GstinLookup {
  id         String   @id @default(cuid())
  gstin      String   @unique
  status     String
  legalName  String?
  tradeName  String?
  address    String?
  stateCode  String?
  pincode    String?
  fetchedAt  DateTime @default(now()) @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  createdBy  String?
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  updatedBy  String?

  @@schema("finance")
}

/// BR-05 step 3, F017. Keyword rules applied in priority order (lowest number first).
model CategorizationRule {
  id               String      @id @default(cuid())
  name             String
  priority         Int
  /// narration, counterparty_name, mode, remark, utr
  matchField       String
  /// contains, equals, starts_with, regex (case-insensitive)
  operator         String
  matchValue       String
  /// debit, credit, or null for both
  direction        String?
  amountMin        Decimal?    @db.Decimal(14, 2)
  amountMax        Decimal?    @db.Decimal(14, 2)
  setCategoryId    String
  setSubCategoryId String?
  /// Null = the sub-category's nature.
  setNature        TxnNature?
  setPartyType     PartyType?
  setDescription   String?
  isActive         Boolean     @default(true)
  /// Created by the seed from the spec's default rules.
  isSeeded         Boolean     @default(false)
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  createdBy        String?
  updatedAt        DateTime    @updatedAt @db.Timestamptz(6)
  updatedBy        String?

  @@index([priority])
  @@schema("finance")
}

/// F004. Rates are data with effective dates so a change never rewrites old documents.
model GstRate {
  id            String    @id @default(cuid())
  rate          Decimal   @db.Decimal(5, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  note          String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  createdBy     String?
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  updatedBy     String?

  @@unique([rate, effectiveFrom])
  @@schema("finance")
}

/// F005. Seeded with old-Act values, all [Verify] until the CA confirms (Q15).
model TdsSection {
  id              String    @id @default(cuid())
  codeOldAct      String
  codeNewAct      String?
  nature          String
  rateIndividual  Decimal   @db.Decimal(5, 2)
  rateOthers      Decimal   @db.Decimal(5, 2)
  rateNoPan       Decimal   @db.Decimal(5, 2)
  /// Deduct when one payment exceeds this.
  singleThreshold Decimal?  @db.Decimal(14, 2)
  /// Deduct when the FY total to the vendor exceeds this (then on the full FY amount, BR-12).
  annualThreshold Decimal?  @db.Decimal(14, 2)
  thresholdNote   String?
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date
  verifiedByCa    Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  createdBy       String?
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  updatedBy       String?

  @@unique([codeOldAct, nature, effectiveFrom])
  @@schema("finance")
}

/// F006, BR-30. pattern uses {FY} and {N}: "ELPL/{FY}/{N}". One row per document type and FY
/// (fyLabel null = never resets, e.g. PMT-{N}). nextNumber only ever goes up (database check).
model NumberSeries {
  id         String   @id @default(cuid())
  entityId   String
  docType    String
  fyLabel    String?
  pattern    String
  padding    Int      @db.SmallInt
  nextNumber Int      @default(1)
  /// Live series issue numbers. Tax invoice / credit note stay off until the invoicing entity
  /// is confirmed (CLAUDE.md "Open blocker").
  isActive   Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  createdBy  String?
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  updatedBy  String?
  entity     Company  @relation(fields: [entityId], references: [id])

  @@unique([entityId, docType, fyLabel])
  @@schema("finance")
}

/// F009. Default terms per vendor and customer, copied to documents (BR-23).
model PaymentTerm {
  id        String   @id @default(cuid())
  label     String   @unique
  days      Int      @default(0)
  /// Advance terms: due date = document date (BR-23).
  isAdvance Boolean  @default(false)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  createdBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  updatedBy String?

  @@schema("finance")
}

/// F007, BR-26. Provision only: every band is switched off at launch (Q9).
model ApprovalRule {
  id                String   @id @default(cuid())
  appliesTo         String
  amountFrom        Decimal  @db.Decimal(14, 2)
  amountTo          Decimal? @db.Decimal(14, 2)
  approversRequired Int      @default(1) @db.SmallInt
  isEnabled         Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  createdBy         String?
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)
  updatedBy         String?

  @@schema("finance")
}

/// F008, BR-36. One row per month that has ever been locked; unlocking keeps the row with the
/// reason (the AuditLog keeps every lock and unlock).
model PeriodLock {
  id           String    @id @default(cuid())
  entityId     String
  /// First day of the month.
  month        DateTime  @db.Date
  isLocked     Boolean   @default(true)
  lockedAt     DateTime  @default(now()) @db.Timestamptz(6)
  lockedBy     String
  unlockedAt   DateTime? @db.Timestamptz(6)
  unlockedBy   String?
  unlockReason String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  createdBy    String?
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  updatedBy    String?

  @@unique([entityId, month])
  @@schema("finance")
}

// ---------- Categories (BR-04) ----------

enum TxnNature {
  operating_income
  operating_expense
  cogs
  capex
  financing_in
  financing_out
  interest
  tax_payment
  advance
  transfer
  related_party
  refund_reversal
  reimbursement

  @@schema("finance")
}

/// Seeded from the Category Master table in docs/spec.md.
model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  natureDefault TxnNature
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  createdBy     String?
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)
  updatedBy     String?
  subCategories SubCategory[]

  @@schema("finance")
}

model SubCategory {
  id             String     @id @default(cuid())
  categoryId     String
  name           String
  /// Set only when this sub-category's nature differs from its category's default.
  natureOverride TxnNature?
  /// Management P&L group (Revenue, Fulfilment, Capex (not in P&L), ...).
  plGroup        String?
  note           String?
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  createdBy      String?
  updatedAt      DateTime   @updatedAt @db.Timestamptz(6)
  updatedBy      String?
  category       Category   @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, name])
  @@schema("finance")
}

// ============================================================================
// M04 Purchase Orders (Phase 2)
// ============================================================================

/// Saved delivery addresses for POs (F041): Bangalore office, Ambala CM premises, ...
model DeliveryAddress {
  id        String   @id @default(cuid())
  label     String   @unique
  address   String
  stateCode String   @db.Char(2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  createdBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  updatedBy String?

  @@schema("finance")
}

/// Purchase catalogue (F042): things we buy, with HSN and the last rate paid.
model PurchaseItem {
  id                String   @id @default(cuid())
  name              String   @unique
  hsnSac            String?
  unit              String   @default("Nos")
  defaultGstRate    Decimal? @db.Decimal(5, 2)
  preferredVendorId String?
  lastRate          Decimal? @db.Decimal(14, 4)
  isArchived        Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  createdBy         String?
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)
  updatedBy         String?

  @@schema("finance")
}

/// Stored, but never typed: draft -> approved (issue) -> sent -> closed / cancelled are actions;
/// partially_billed / fully_billed are computed from linked tax invoices (BR-17).
enum PoStatus {
  draft
  pending_approval
  approved
  sent
  partially_billed
  fully_billed
  closed
  cancelled

  @@schema("finance")
}

model PurchaseOrder {
  id                   String    @id @default(cuid())
  entityId             String
  /// Assigned on Issue only (BR-30). Null while draft.
  poNumber             String?   @unique
  poDate               DateTime  @db.Date
  vendorId             String
  expectedDeliveryDate DateTime? @db.Date
  deliveryAddressId    String?
  deliveryAddress      String
  /// Place of supply = delivery state (BR-20).
  placeOfSupplyState   String    @db.Char(2)
  /// cgst_sgst, igst or none, from vendor state vs place of supply.
  gstMode              String
  quoteRef             String?
  paymentTermId        String?
  paymentTermsText     String?
  /// [{label, percent, trigger}] (F043)
  milestones           Json      @default("[]")
  termsText            String?
  notes                String?
  taxable              Decimal   @default(0) @db.Decimal(14, 2)
  cgst                 Decimal   @default(0) @db.Decimal(14, 2)
  sgst                 Decimal   @default(0) @db.Decimal(14, 2)
  igst                 Decimal   @default(0) @db.Decimal(14, 2)
  roundOff             Decimal   @default(0) @db.Decimal(14, 2)
  total                Decimal   @default(0) @db.Decimal(14, 2)
  /// Kept up to date from vendor documents (M05) and payments (M06).
  billedTaxable        Decimal   @default(0) @db.Decimal(14, 2)
  billedTotal          Decimal   @default(0) @db.Decimal(14, 2)
  paidTotal            Decimal   @default(0) @db.Decimal(14, 2)
  advanceTotal         Decimal   @default(0) @db.Decimal(14, 2)
  status               PoStatus  @default(draft)
  statusReason         String?
  revisionNo           Int       @default(0)
  /// Only used when approval bands are switched on (BR-26): [{userId, at}].
  approvals            Json      @default("[]")
  issuedAt             DateTime? @db.Timestamptz(6)
  issuedBy             String?
  sentAt               DateTime? @db.Timestamptz(6)
  sentVia              String?
  closedAt             DateTime? @db.Timestamptz(6)
  pdfAttachmentId      String?
  templateVersion      String?
  /// Vendor and company details frozen at issue (issued documents are immutable).
  vendorSnapshot       Json?
  companySnapshot      Json?
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  createdBy            String?
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
  updatedBy            String?
  vendor               Vendor    @relation(fields: [vendorId], references: [id])
  lines                PoLine[]
  revisions            PoRevision[]
  documents            VendorDocument[]

  @@index([vendorId])
  @@index([status])
  @@schema("finance")
}

model PoLine {
  id             String        @id @default(cuid())
  poId           String
  lineNo         Int
  purchaseItemId String?
  description    String
  hsnSac         String?
  qty            Decimal       @db.Decimal(14, 3)
  unit           String        @default("Nos")
  rate           Decimal       @db.Decimal(14, 4)
  discount       Decimal       @default(0) @db.Decimal(14, 2)
  gstRate        Decimal       @db.Decimal(5, 2)
  taxable        Decimal       @db.Decimal(14, 2)
  cgst           Decimal       @db.Decimal(14, 2)
  sgst           Decimal       @db.Decimal(14, 2)
  igst           Decimal       @db.Decimal(14, 2)
  lineTotal      Decimal       @db.Decimal(14, 2)
  qtyBilled      Decimal       @default(0) @db.Decimal(14, 3)
  /// Lines are never deleted: an edit archives the old lines and adds new ones.
  isArchived     Boolean       @default(false)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  createdBy      String?
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  updatedBy      String?
  po             PurchaseOrder @relation(fields: [poId], references: [id])

  @@index([poId])
  @@schema("finance")
}

/// F046 amendment: the PO as it was before revision N, with the reason.
model PoRevision {
  id         String        @id @default(cuid())
  poId       String
  revisionNo Int
  reason     String
  before     Json
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  createdBy  String?
  updatedAt  DateTime      @updatedAt @db.Timestamptz(6)
  updatedBy  String?
  po         PurchaseOrder @relation(fields: [poId], references: [id])

  @@unique([poId, revisionNo])
  @@schema("finance")
}

// ============================================================================
// M05 Vendor documents (Phase 2): quotes, proformas, tax invoices, debit and credit notes
// ============================================================================

enum VendorDocType {
  quote
  proforma
  tax_invoice
  debit_note
  credit_note

  @@schema("finance")
}

/// Computed from the document type, payments and actions (Status Flows); never typed.
enum VendorDocStatus {
  awaiting_tax_invoice
  received
  approved
  partially_paid
  paid
  disputed
  replaced
  cancelled

  @@schema("finance")
}

model VendorDocument {
  id                 String          @id @default(cuid())
  entityId           String
  docType            VendorDocType
  vendorId           String
  docNumber          String
  /// BR-19: docNumber without spaces, upper case. Unique per vendor and FY (finance.sql).
  docNumberKey       String
  fyLabel            String
  docDate            DateTime        @db.Date
  receivedDate       DateTime?       @db.Date
  poId               String?
  /// F057: the quote or proforma this tax invoice replaces.
  replacesDocumentId String?
  /// Debit / credit notes: the invoice they adjust.
  againstDocumentId  String?
  placeOfSupplyState String          @db.Char(2)
  gstMode            String
  reverseCharge      Boolean         @default(false)
  taxableValue       Decimal         @default(0) @db.Decimal(14, 2)
  cgst               Decimal         @default(0) @db.Decimal(14, 2)
  sgst               Decimal         @default(0) @db.Decimal(14, 2)
  igst               Decimal         @default(0) @db.Decimal(14, 2)
  /// Non-taxable fees on the vendor's document (BR-18), e.g. government fees.
  otherCharges       Decimal         @default(0) @db.Decimal(14, 2)
  roundOff           Decimal         @default(0) @db.Decimal(14, 2)
  totalValue         Decimal         @default(0) @db.Decimal(14, 2)
  /// Set when the GST typed from the vendor's copy differs from the computed split (F053).
  taxMismatch        String?
  tdsApplicable      Boolean         @default(false)
  tdsSectionId       String?
  tdsBase            Decimal         @default(0) @db.Decimal(14, 2)
  tdsRate            Decimal         @default(0) @db.Decimal(5, 2)
  tdsAmount          Decimal         @default(0) @db.Decimal(14, 2)
  /// What the app suggested and why (BR-11, BR-12), kept next to what was used.
  tdsSuggestion      Json?
  tdsOverrideReason  String?
  /// Filled by payments (M06): advances moved onto this document, payments, notes.
  advancesApplied    Decimal         @default(0) @db.Decimal(14, 2)
  paidAmount         Decimal         @default(0) @db.Decimal(14, 2)
  notesAdjustment    Decimal         @default(0) @db.Decimal(14, 2)
  netPayable         Decimal         @default(0) @db.Decimal(14, 2)
  outstanding        Decimal         @default(0) @db.Decimal(14, 2)
  categoryId         String?
  subCategoryId      String?
  nature             TxnNature?
  paymentTermId      String?
  dueDate            DateTime?       @db.Date
  status             VendorDocStatus
  statusReason       String?
  approvedBy         String?
  approvedAt         DateTime?       @db.Timestamptz(6)
  itcEligible        Boolean         @default(true)
  notes              String?
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  createdBy          String?
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)
  updatedBy          String?
  vendor             Vendor          @relation(fields: [vendorId], references: [id])
  po                 PurchaseOrder?  @relation(fields: [poId], references: [id])
  lines              VendorDocumentLine[]

  @@index([vendorId])
  @@index([poId])
  @@index([status])
  @@schema("finance")
}

model VendorDocumentLine {
  id          String         @id @default(cuid())
  docId       String
  lineNo      Int
  poLineId    String?
  description String
  hsnSac      String?
  qty         Decimal        @db.Decimal(14, 3)
  unit        String         @default("Nos")
  rate        Decimal        @db.Decimal(14, 4)
  discount    Decimal        @default(0) @db.Decimal(14, 2)
  gstRate     Decimal        @db.Decimal(5, 2)
  taxable     Decimal        @db.Decimal(14, 2)
  cgst        Decimal        @db.Decimal(14, 2)
  sgst        Decimal        @db.Decimal(14, 2)
  igst        Decimal        @db.Decimal(14, 2)
  lineTotal   Decimal        @db.Decimal(14, 2)
  isArchived  Boolean        @default(false)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  createdBy   String?
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)
  updatedBy   String?
  doc         VendorDocument @relation(fields: [docId], references: [id])

  @@index([docId])
  @@schema("finance")
}

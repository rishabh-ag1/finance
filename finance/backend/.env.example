# Postgres. Finance owns only the "finance" schema; later this is the same database as the CRM (bloccrm).
# Local example: postgresql://postgres:<password>@localhost:5432/entelechy_finance
DATABASE_URL=
# Separate database used by `npm test` (it is wiped and re-synced by the tests). Leave empty to skip DB tests.
DATABASE_URL_TEST=

PORT=3100
FRONTEND_URL=http://localhost:5174

# Signs the login cookie. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Used once by `npm run db:seed` to set the founders' first password (change it after first login).
SEED_ADMIN_PASSWORD=

# GST "Verify & Fetch" (gstinapi.in) - the same key the CRM uses. Checksum validation runs without it.
GSTINAPI_KEY=
